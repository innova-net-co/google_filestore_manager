{
    "workbench.colorCustomizations": {
        "activityBar.activeBackground": "#54af29",
        "activityBar.background": "#54af29",
        "activityBar.foreground": "#15202b",
        "activityBar.inactiveForeground": "#15202b99",
        "activityBarBadge.background": "#e5ecf9",
        "activityBarBadge.foreground": "#15202b",
        "commandCenter.border": "#e7e7e799",
        "sash.hoverBorder": "#54af29",
        "statusBar.background": "#40861f",
        "statusBar.foreground": "#e7e7e7",
        "statusBarItem.hoverBackground": "#54af29",
        "statusBarItem.remoteBackground": "#40861f",
        "statusBarItem.remoteForeground": "#e7e7e7",
        "titleBar.activeBackground": "#40861f",
        "titleBar.activeForeground": "#e7e7e7",
        "titleBar.inactiveBackground": "#40861f99",
        "titleBar.inactiveForeground": "#e7e7e799"
    },
    "peacock.color": "#40861f",
    "deno.enable": false,
    "python.envFile": "${workspaceFolder}/.env",
        "terminal.integrated.env.windows": {
            "PYTHONPATH": "${workspaceFolder}"
        },
        "chat.tools.terminal.autoApprove": {
            "Set-Content": true,
            "npm install": true
        },
    "css.lint.unknownAtRules": "ignore",
    "scss.lint.unknownAtRules": "ignore"
}